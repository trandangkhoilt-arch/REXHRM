# NexHRM Environment Configuration Example
DATABASE_URL="postgresql://user:password@localhost:5432/nexhrm_db?schema=public"

# Authentication & Session Security
JWT_SECRET="replace-with-a-very-long-random-secret-key-at-least-32-chars"
SESSION_COOKIE_NAME="nexhrm_session"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WebAuthn / Passkeys Configuration
WEBAUTHN_RP_NAME="NexHRM Enterprise"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:3000"

# QR Station Dynamic Token Secret
QR_SECRET_KEY="replace-with-qr-secret-key"

# Biometrics & Liveness
# Options: "unconfigured" | "internal_test" | "external_provider"
LIVENESS_PROVIDER="unconfigured"
LIVENESS_API_KEY=""

# Application Mode
NODE_ENV="production"
